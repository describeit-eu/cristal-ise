{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StateMachine",
  "type": "object",
  "properties": {
    "namespace": {
      "type": ["string", "null"]
    },
    "name": {
      "type": ["string", "null"]
    },
    "version": {
      "type": ["string", "null"]
    },
    "itemID": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "states": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/state"
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/transition"
      }
    },
    "initialStateId": {
      "type": ["integer", "null"]
    },
    "finalStateIds": {
      "type": ["array", "null"],
      "items": {
        "type": "integer"
      }
    }
  },
  "required": [
    "states",
    "transitions"
  ],
  "definitions": {
    "state": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": ["string", "null"]
        },
        "finishing": {
          "type": "boolean"
        },
        "initial": {
          "type": "boolean"
        },
        "transitionIds": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id"
      ]
    },
    "transition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": ["string", "null"]
        },
        "originStateId": {
          "type": "integer"
        },
        "targetStateId": {
          "type": "integer"
        },
        "reservation": {
          "type": ["string", "null"]
        },
        "errorHandler": {
          "type": "boolean"
        },
        "enablerProp": {
          "type": ["string", "null"]
        },
        "requiresActive": {
          "type": "boolean"
        },
        "finishing": {
          "type": "boolean"
        },
        "reInitializes": {
          "type": "boolean"
        },
        "schema": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "script": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "query": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "originStateId",
        "targetStateId"
      ]
    }
  }
}
